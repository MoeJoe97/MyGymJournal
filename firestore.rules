rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function validUserProfileData() {
      return request.resource.data.keys().hasAll([
        'admin', 'nickname', 'email', 'address', 'street', 'postalCode',
        'city', 'country', 'birthDate'
      ])
      && request.resource.data.keys().hasOnly([
        'admin', 'nickname', 'email', 'address', 'street', 'postalCode',
        'city', 'country', 'birthDate', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.admin is bool
      && request.resource.data.nickname is string
      && request.resource.data.nickname.size() > 0
      && request.resource.data.nickname.size() <= 80
      && request.resource.data.email is string
      && request.resource.data.email.size() > 0
      && request.resource.data.email.size() <= 320
      && request.resource.data.address is string
      && request.resource.data.address.size() <= 500
      && request.resource.data.street is string
      && request.resource.data.street.size() <= 200
      && request.resource.data.postalCode is string
      && request.resource.data.postalCode.size() <= 32
      && request.resource.data.city is string
      && request.resource.data.city.size() <= 120
      && request.resource.data.country is string
      && request.resource.data.country.size() <= 120
      && request.resource.data.birthDate is string
      && request.resource.data.birthDate.size() <= 20;
    }

    function validExerciseData() {
      return request.resource.data.keys().hasAll(['name'])
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
    }

    function validBodyWeightData() {
      return request.resource.data.keys().hasAll(['weight', 'dayKey', 'timestamp'])
        && request.resource.data.keys().hasOnly(['weight', 'dayKey', 'timestamp', 'updatedAt'])
        && request.resource.data.weight is number
        && request.resource.data.weight > 0
        && request.resource.data.weight <= 1000
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timestamp is timestamp;
    }

    function validOptionalWorkoutGrouping() {
      return (!('setType' in request.resource.data)
          || request.resource.data.setType in ['normal', 'superset', 'dropset'])
        && (!('groupId' in request.resource.data)
          || request.resource.data.groupId == null
          || (request.resource.data.groupId is string
            && request.resource.data.groupId.size() > 0
            && request.resource.data.groupId.size() <= 120))
        && (!('groupPosition' in request.resource.data)
          || request.resource.data.groupPosition == null
          || (request.resource.data.groupPosition is int
            && request.resource.data.groupPosition > 0
            && request.resource.data.groupPosition <= 20))
        && (!('setType' in request.resource.data)
          || request.resource.data.setType == 'normal'
          || (request.resource.data.groupId is string
            && request.resource.data.groupId.size() > 0
            && request.resource.data.groupPosition is int
            && request.resource.data.groupPosition > 0));
    }

    function validWorkoutData() {
      return request.resource.data.keys().hasAll([
        'userId', 'exercise', 'exerciseDisplay', 'repetitions', 'weight',
        'setNumber', 'dayKey', 'rpe', 'e1RM', 'intensityVolume', 'timestamp'
      ])
      && request.resource.data.keys().hasOnly([
        'userId', 'exercise', 'exerciseDisplay', 'repetitions', 'weight',
        'setNumber', 'dayKey', 'rpe', 'e1RM', 'intensityVolume', 'timestamp',
        'updatedAt', 'setType', 'groupId', 'groupPosition'
      ])
      && request.resource.data.userId is string
      && request.resource.data.userId.size() > 0
      && request.resource.data.exercise is string
      && request.resource.data.exercise.size() > 0
      && request.resource.data.exercise.size() <= 120
      && request.resource.data.exerciseDisplay is string
      && request.resource.data.exerciseDisplay.size() > 0
      && request.resource.data.exerciseDisplay.size() <= 120
      && request.resource.data.repetitions is int
      && request.resource.data.repetitions > 0
      && request.resource.data.repetitions <= 1000
      && request.resource.data.weight is number
      && request.resource.data.weight > 0
      && request.resource.data.weight <= 10000
      && request.resource.data.setNumber is int
      && request.resource.data.setNumber > 0
      && request.resource.data.setNumber <= 1000
      && request.resource.data.dayKey is string
      && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.rpe is number
      && request.resource.data.rpe >= 0
      && request.resource.data.rpe <= 10
      && request.resource.data.e1RM is number
      && request.resource.data.e1RM > 0
      && request.resource.data.e1RM <= 100000
      && request.resource.data.intensityVolume is number
      && request.resource.data.intensityVolume >= 0
      && request.resource.data.timestamp is timestamp
      && validOptionalWorkoutGrouping();
    }

    match /users/{userId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validUserProfileData()
        && request.resource.data.admin == false
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && validUserProfileData()
        && request.resource.data.admin == resource.data.admin
        && request.resource.data.admin == false
        && request.resource.data.email == resource.data.email
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isOwner(userId);

      match /exercises/{exerciseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validExerciseData();
        allow delete: if isOwner(userId);
        allow create, update, delete: if isAdmin();
      }

      match /bodyWeights/{weightEntryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validBodyWeightData();
        allow delete: if isOwner(userId);
        allow create, update, delete: if isAdmin();
      }
    }

    match /workouts/{workoutId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && validWorkoutData();
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.exercise == resource.data.exercise
          && request.resource.data.setNumber == resource.data.setNumber
          && request.resource.data.dayKey == resource.data.dayKey
          && validWorkoutData());
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
