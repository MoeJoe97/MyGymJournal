rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.admin == false && request.resource.data.email == request.auth.token.email;
      allow update: if owner(uid) && request.resource.data.admin == resource.data.admin && request.resource.data.email == resource.data.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','updatedAt','address','street','postalCode','city','country','birthDate']);
      allow delete: if owner(uid);
      match /exercises/{exerciseId} { allow read, write: if owner(uid); }
      match /bodyWeights/{dayKey} { allow read, write: if owner(uid); }
    }
    match /workouts/{workoutId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.setNumber is int && request.resource.data.repetitions is int && request.resource.data.repetitions > 0 && request.resource.data.weight is number && request.resource.data.weight >= 0;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
  }
}
