rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    function validNickname(data) {
      return data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 80;
    }
    function profileKeysValid(data) {
      return data.keys().hasOnly(['admin', 'nickname', 'email', 'createdAt', 'updatedAt']);
    }
    function validWorkout(data) {
      return data.userId is string
        && data.exercise is string && data.exercise.size() > 0 && data.exercise.size() <= 160
        && data.exerciseDisplay is string && data.exerciseDisplay.size() > 0 && data.exerciseDisplay.size() <= 160
        && data.repetitions is int && data.repetitions > 0 && data.repetitions <= 1000
        && data.weight is number && data.weight >= 0 && data.weight <= 10000
        && data.setNumber is int && data.setNumber > 0
        && data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timestamp is timestamp
        && (!('rpe' in data) || data.rpe == null || (data.rpe is number && data.rpe >= 0 && data.rpe <= 10))
        && (!('e1RM' in data) || (data.e1RM is number && data.e1RM >= 0))
        && (!('intensityVolume' in data) || (data.intensityVolume is number && data.intensityVolume >= 0))
        && (!('setType' in data) || data.setType in ['normal', 'superset', 'dropset'])
        && (!('groupId' in data) || data.groupId == null || data.groupId is string)
        && (!('groupPosition' in data) || data.groupPosition == null || (data.groupPosition is int && data.groupPosition > 0));
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && profileKeysValid(request.resource.data)
        && request.resource.data.admin == false
        && request.resource.data.email == request.auth.token.email
        && validNickname(request.resource.data)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if owner(uid)
        && profileKeysValid(request.resource.data)
        && request.resource.data.admin == resource.data.admin
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && validNickname(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt', 'address', 'street', 'postalCode', 'city', 'country', 'birthDate']);
      allow delete: if false;

      match /exercises/{exerciseId} {
        allow read, create, update, delete: if owner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160;
        allow read: if owner(uid);
      }
      match /bodyWeights/{dayKey} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['weight', 'dayKey', 'timestamp'])
          && request.resource.data.weight is number
          && request.resource.data.weight > 0
          && request.resource.data.weight <= 1000
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.timestamp is timestamp;
        allow delete: if owner(uid);
      }
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow create, update, delete: if admin()
        && request.resource.data.keys().hasOnly(['name', 'description', 'muscleGroup', 'equipment', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160;
    }

    match /workouts/{workoutId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validWorkout(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && validWorkout(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
